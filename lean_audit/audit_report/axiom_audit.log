FinitePrecisionLanczos.LanczosRun.ritz_residual_bound_div {n k : ℕ} (L : FinitePrecisionLanczos.LanczosRun n k)
  (y : FinitePrecisionLanczos.Vec k) (theta : ℝ) (hy : FinitePrecisionLanczos.vdot y y = 1)
  (heig : Matrix.mulVec L.Tmat y = theta • y) (hx : 0 < FinitePrecisionLanczos.vnorm (L.ritzVector y)) :
  FinitePrecisionLanczos.vnorm (Matrix.mulVec L.H (L.ritzVector y) - theta • L.ritzVector y) /
      FinitePrecisionLanczos.vnorm (L.ritzVector y) ≤
    (√(1 + L.ε) * L.β k * |y (FinitePrecisionLanczos.LanczosRun.lastIndex ⋯)| + ‖L.Fmat‖) /
      FinitePrecisionLanczos.vnorm (L.ritzVector y)
