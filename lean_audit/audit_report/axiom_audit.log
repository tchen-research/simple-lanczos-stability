FinitePrecisionLanczos.LanczosRun.starting_lipschitz {n k : ℕ} (L : FinitePrecisionLanczos.LanczosRun n k) (f : ℝ → ℝ)
  (hf : FinitePrecisionLanczos.OneLipschitz f) :
  |L.normalizedStart ⬝ᵥ (cfc f L.H).mulVec L.normalizedStart -
