FinitePrecisionLanczos.LanczosRun.greenbaum_localization_exists {n k : ℕ} (L : FinitePrecisionLanczos.LanczosRun n k)
  (y : FinitePrecisionLanczos.Vec k) (theta : ℝ) (hy : FinitePrecisionLanczos.vdot y y = 1)
  (heig : Matrix.mulVec L.Tmat y = theta • y) :
  ∃ i,
    |theta - ⋯.eigenvalues i| ≤
